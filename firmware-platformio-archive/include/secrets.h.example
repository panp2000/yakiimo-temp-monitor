// secrets.h (このファイルをコピーして secrets.h にリネーム、実値を埋める)
// secrets.h は .gitignore で除外されるのでコミットされない

#pragma once

// --- WiFi 設定 ---
// 自宅 WiFi(釜場まで届く前提)。届かなければスマホテザリングの SSID/パスを入れる
#define WIFI_SSID     "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// --- Supabase 設定 ---
// Supabase プロジェクト
// URL は固定: https://YOUR_PROJECT.supabase.co
// ANON KEY は Supabase ダッシュボード → Project Settings → API → anon public で取得
#define SUPABASE_URL      "https://YOUR_PROJECT.supabase.co"
#define SUPABASE_ANON_KEY "YOUR_SUPABASE_ANON_KEY_HERE"

// --- セッション識別子 ---
// 計測セッションを区別するためのラベル(自由文字列)。
// 例: "2026-05-03-round1" / "test-bench-2026-05-02"
// ラウンドが変わったら書き換えて再書き込み
#define SESSION_ID "2026-05-03-round1"

// --- デバイス ID(複数 ESP32 を運用するなら識別子を変える) ---
#define DEVICE_ID "esp32-01"
