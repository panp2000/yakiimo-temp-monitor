# yakiimo-temp-monitor / ESPHome secrets
#
# 使い方:
#   cp secrets.yaml.example secrets.yaml
#   # secrets.yaml を編集して実値を入れる
#   # secrets.yaml は .gitignore で除外される(コミットされない)
#
# ESPHome の !secret 参照は YAML 解釈時に静的展開される。
# lambda 内では参照できない点に注意(yakiimo.yaml は substitutions: 経由で
# lambda に渡している項目があるが、本ファイルは普通の key: value で OK)。

# --- WiFi 設定 ---
# WiFi 認証情報 (複数登録、ESP32 が起動時にスキャンして利用可能なものに自動接続)
# 家庭の WiFi (本拠地で使う電波)
wifi_ssid_home: "YOUR_HOME_WIFI_SSID"
wifi_password_home: "YOUR_HOME_WIFI_PASSWORD"

# iPhone テザリング等の出張用 WiFi
wifi_ssid_tether: "YOUR_TETHER_SSID"
wifi_password_tether: "YOUR_TETHER_PASSWORD"

# --- AP フォールバック ---
# WiFi 接続失敗時に ESP32 が立ち上げる captive portal AP のパスワード
# (ESPHome は空欄を許さないので必ず何か入れる。8文字以上推奨)
fallback_password: "yakiimo-fallback-ap"

# --- OTA(Over-The-Air アップデート)用パスワード ---
# 初回 USB 書き込み後、以降はネットワーク経由で再書き込みするときに使う
# (ESPHome は空欄を許さないので必ず何か入れる)
ota_password: "yakiimo-ota-password"

# --- web_server の Basic 認証 ---
# Web UI のアクセス制御。家庭内 LAN なので緩めでも OK
# 不要なら yakiimo.yaml の web_server: ブロック内で auth を消してもよい
web_username: "admin"
web_password: "yakiimo-web"

# --- Supabase 設定 ---
# Supabase プロジェクト
# URL は末尾に /rest/v1 を付けない(yakiimo.yaml の lambda 内で組み立てる)
supabase_url: "https://YOUR_PROJECT.supabase.co"

# anon public key: Supabase ダッシュボード → Project Settings → API → anon public
supabase_anon_key: "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY_HERE"

# --- セッション識別子 ---
# 計測セッションを区別するためのラベル(自由文字列)。
# 例: "2026-05-04-round1" / "test-bench-2026-05-04"
# この値は初回起動時の初期値のみ。以降は Web UI から変更可で NVS に永続化される。
session_id: "2026-05-04-round1"

# --- 屋号 (店名) ---
# ダッシュボードのタイトルや ESPHome Web UI に表示される
# 例: "高砂", "焼き芋本舗", "Sweet Potato Lab" など
# 空文字でも構わぬが、ブランド表記したいなら設定
brand_name: "[屋号]"
