{
  "name": "@yakiimo/contract",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./envelope": "./src/envelope.ts",
    "./payload": "./src/payload.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "codegen": "npm-run-all -p codegen:*",
    "codegen:c-header": "tsx codegen/emit-c-header.ts",
    "codegen:sql": "tsx codegen/emit-sql-functions.ts",
    "codegen:doc": "tsx codegen/emit-doc.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0",
    "tsx": "^4.7.0",
    "npm-run-all": "^4.1.5"
  }
}
